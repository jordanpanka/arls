# Copy to .env (next to docker-compose.yml) to override the compose defaults.
# .env is gitignored - the real API key must never be committed.
#
# Leave this file untouched and the stack runs FULLY LOCAL against the Ollama
# instance on your host: no API key needed.

# --- Ollama Cloud (optional) ---------------------------------------------
# Node summaries go through call_llm(), which posts to {OLLAMA_BASE_URL}/generate
# using GEN_MODEL_CLOUD. Point these at the cloud to offload that work.
#OLLAMA_BASE_URL=https://ollama.com/api
#OLLAMA_API_KEY=your-key-here
#GEN_MODEL_CLOUD=gpt-oss:120b-cloud
#EMBED_MODEL_CLOUD=mxbai-embed-large

# --- Local models (defaults shown) ---------------------------------------
#OLLAMA_URL=http://host.docker.internal:11434
#GEN_MODEL=llama3:latest
#EMBED_MODEL=embeddinggemma:latest

# Must match the output dimension of EMBED_MODEL (embeddinggemma = 768).
# Changing this requires recreating the Qdrant collection.
#EMBED_DIM=768
