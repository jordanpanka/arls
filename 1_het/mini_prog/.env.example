# Copy to .env (next to docker-compose.yml) to override the compose defaults.
# .env is gitignored - the real API key must never be committed.
#
# Leave this file untouched and the stack runs FULLY LOCAL against the Ollama
# instance on your host: no API key needed.

# --- Ollama Cloud (optional) ---------------------------------------------
# Node summaries go through call_llm(), which posts to {OLLAMA_BASE_URL}/generate
# using GEN_MODEL_CLOUD. Point these at the cloud to offload that work.
#OLLAMA_BASE_URL=https://ollama.com/api
#OLLAMA_API_KEY=your-key-here
#GEN_MODEL_CLOUD=gpt-oss:120b-cloud
#EMBED_MODEL_CLOUD=mxbai-embed-large
# Embeddings post to {EMBED_BASE_URL}/embed. When it equals OLLAMA_BASE_URL and
# an API key is set, EMBED_MODEL_CLOUD is used with the key; otherwise EMBED_MODEL.
# The cloud model's dimension must match the Qdrant collection (768).
#EMBED_BASE_URL=https://ollama.com/api

# --- Local models (defaults shown) ---------------------------------------
#OLLAMA_URL=http://host.docker.internal:11434
#GEN_MODEL=llama3:latest
#EMBED_MODEL=embeddinggemma:latest

# Must match the output dimension of EMBED_MODEL (embeddinggemma = 768).
# Changing this requires recreating the Qdrant collection.
#EMBED_DIM=768

# --- Retrieval strategy ----------------------------------------------------
# Default mode when a chat request does not name one:
# routed_rag (picks adaptive_rag or evidence_aware_agentic_rag per question) | vector_rag | hybrid_rag | adaptive_rag | agentic_rag | evidence_aware_agentic_rag
#CHAT_DEFAULT_MODE=routed_rag
# routed_rag hands a weak pipeline answer to the agent, seeded with the pipeline's hits.
#ROUTER_ESCALATION=true

# --- Agent budgets (evidence_aware_agentic_rag / agentic_rag) ---------------
#AGENT_MAX_ITERATIONS=4
#AGENT_MAX_TOOL_CALLS=12
#AGENT_MAX_CALLS_PER_ITERATION=4
#AGENT_MAX_TOOL_OUTPUT_CHARS=6000
#AGENT_MAX_READ_LINES=200
#AGENT_MAX_GRAPH_DEPTH=3
#AGENT_MAX_CONTEXT_CHARS=24000
#AGENT_TOKEN_BUDGET=60000
#AGENT_TIMEOUT_S=180
#AGENT_TOOL_TIMEOUT_S=20
#AGENT_LLM_TIMEOUT_S=120
#AGENT_MAX_VERIFY_REVISIONS=1
#AGENT_LLM_CLAIM_VERIFICATION=false
#AGENT_ENABLE_HISTORY_TOOLS=false

# --- Design pattern analysis (ablation: ablation=no_patterns) -----------------
#ENABLE_DESIGN_PATTERN_ANALYSIS=true
#PATTERN_MAX_FILES=10
#PATTERN_MAX_FILE_LINES=1600
#PATTERN_MAX_RUNS=2
#PATTERN_MAX_EVIDENCE=24

# --- Evidence sufficiency thresholds (research experiments) ---------------
#SUFF_MIN_COVERAGE=1.0
#SUFF_MIN_RELEVANCE=0.5
#SUFF_MIN_TRACEABILITY=0.6
#SUFF_MIN_SEMANTIC_SCORE=0.35
#SUFF_USE_LLM=false

# --- Cost estimate and traces --------------------------------------------
#LLM_PRICE_IN_PER_1K=0
#LLM_PRICE_OUT_PER_1K=0
#AGENT_TRACE_ENABLED=true
#AGENT_TRACE_DIR=/app/eval/traces
